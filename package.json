{
    "name": "sqlite-executor",
    "version": "4.0.12",
    "private": false,
    "description": "SQLite executor for Node.js",
    "sideEffects": false,
    "packageManager": "yarn@1.22.22",
    "files": [
        "dist"
    ],
    "type": "module",
    "main": "dist/cjs/index.cjs",
    "module": "dist/esm/index.mjs",
    "exports": {
        "./package.json": {
            "import": "./package.json",
            "require": "./package.json"
        },
        ".": {
            "require": {
                "default": "./dist/cjs/index.cjs",
                "types": "./dist/cjs/index.d.cts"
            },
            "import": {
                "default": "./dist/esm/index.mjs",
                "types": "./dist/esm/index.d.mts"
            }
        }
    },
    "scripts": {
        "test": "node script/run-tests.mjs",
        "test:update-snapshots": "node script/run-tests.mjs --test-update-snapshots",
        "coverage": "c8 --all --src=src node script/run-tests.mjs",
        "coverage:html": "c8 --all --src=src --reporter=text --reporter=html --reporter=lcovonly node script/run-tests.mjs",
        "coverage:check": "c8 --all --src=src --check-coverage --lines 90 --functions 90 --branches 90 node script/run-tests.mjs",
        "benchmark": "node benchmark/index.bench.js",
        "benchmark:rw-split": "node benchmark/rw-split.bench.js",
        "benchmark:queue": "node benchmark/queue.bench.js",
        "benchmark:utils": "node benchmark/utils.bench.js",
        "benchmark:process-stream": "node --expose-gc benchmark/process-stream.bench.js",
        "benchmark:stream-handlers": "node --expose-gc benchmark/stream-handler-compare.bench.js",
        "build": "knip && rslib build",
        "prepack": "npm run build"
    },
    "c8": {
        "reporter": [
            "text",
            "html",
            "lcovonly"
        ],
        "exclude": [
            "coverage/**",
            "dist/**",
            "script/**",
            "benchmark/**",
            "fixtures/**",
            "test/**",
            "**/*.test.js",
            "**/*.d.ts",
            "**/node_modules/**"
        ],
        "all": true,
        "src": [
            "src"
        ],
        "check-coverage": false,
        "lines": 90,
        "functions": 90,
        "branches": 90
    },
    "author": "Axetroy <axetroy.dev@gmail.com>",
    "license": "SEE LICENSE IN LICENSE",
    "devDependencies": {
        "@rslib/core": "^0.6.0",
        "@types/node": "^22.14.1",
        "adm-zip": "^0.5.16",
        "axios": "^1.13.5",
        "c8": "^11.0.0",
        "knip": "^5.53.0",
        "outdent": "^0.8.0",
        "typescript": "^5.8.3"
    },
    "keywords": [
        "sqlite",
        "sqlite3",
        "wrapper",
        "nodejs",
        "javascript",
        "typescript"
    ],
    "homepage": "https://github.com/axetroy/sqlite-executor#readme",
    "bugs": {
        "url": "https://github.com/axetroy/sqlite-executor/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/axetroy/sqlite-executor.git"
    }
}
